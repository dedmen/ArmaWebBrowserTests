class RscDisplayRef
{
	idd=157;
	class Controls
	{
		class VideoTest: RscText
		{
		    type=108;
			idc=1337;
			x= safeZoneX;
			y= safeZoneY + 0.5;
			w= 0.5;
			h= 0.5;
		};
	};
	
	onLoad = "_disp = _this#0; _ctrl = _this#0 displayCtrl 1337; _ctrl ctrlWebBrowserAction ['SetBrowserReference', GMyData#0 displayCtrl 1337];";
};

class RscDisplayRefAlpha
{
	idd=157;
	class Controls
	{
		class VideoTest: RscText
		{
		    type=108;
			idc=1337;
			x = safeZoneX;
			y = safeZoneY;
			w = safeZoneW;
			h = safeZoneH;
			
			fade = 0.95;
		};
	};
	
	onLoad = "_disp = _this#0; _ctrl = _this#0 displayCtrl 1337; _ctrl ctrlWebBrowserAction ['SetBrowserReference', GMyData#0 displayCtrl 1337];";
};

class RscDisplayRefFlippy
{
	idd=157;
	class Controls
	{
		class VideoTest: RscText
		{
		    type=108;
			idc=1337;
			x= safeZoneX;
			y= safeZoneY + 0.5;
			w = 1;
			h = 1;
			
			fade = 0.2;
		};
	};
	
	onLoad = "addMissionEventHandler ['EachFrame', {_disp = _thisArgs#0; displayUpdate _disp;}, [_this#0]]; _ctrl = _this#0 displayCtrl 1337; _ctrl spawn {while {!isNull _this} do {_this ctrlWebBrowserAction ['SetBrowserReference', GMyData#0 displayCtrl 1337]; uiSleep 0.5; _this ctrlWebBrowserAction ['SetBrowserReference', GMyData2#0 displayCtrl 1337]; uiSleep 0.5;   } };";
	
	
	
};


class PLP_Test
{
	idd = 15002;
	class controls
	{
		class Texture: RscText
		{
		type=106;
			idc = 1337;
			//x = safeZoneX;
			//y = safeZoneY+safeZoneH-(pixelH*2048);
			x = 0;
			y = 0;
			w = 1;
			h = 1;
			colorText[] = {1,1,1,1};
			text = "#(rgb,1,1,1)color(0.5,0,0,1,ca)";
			
			allowExternalURL = 1; // This makes it require manual approval by user
			url = "https://www.youtube.com/watch?v=k8Jtm1eNpeU";
		
		};
	};
	onLoad = "GMyData2 = _this, uiNamespace setVariable ['GMyData2', _this]; addMissionEventHandler ['EachFrame', {_disp = _thisArgs#0; displayUpdate _disp;}, [_this#0]];";
};

class RscTitles
{
	class KillTrackerUI
	{
		idd = 15002;
		fadein = 0;
		fadeout = 0;
		duration = 1e+011;
		onLoad = "GKillTracker = _this";

		class controls
		{
			class Texture: RscText
			{
				type=106;
				idc = 1337;
				x = safeZoneX;
				//y = safeZoneY+safeZoneH-(pixelH*2048);
				y = safeZoneY;
				w = safeZoneW;
				h = safeZoneH;
				colorText[] = {1,1,1,1};
				text = "#(rgb,1,1,1)color(0.5,0,0,1,ca)";
				
				
				url = "https://www.youtube.com/watch?v=k8Jtm1eNpeU";
			
			};
		};
	};
}
